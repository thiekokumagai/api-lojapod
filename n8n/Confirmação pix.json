    {
      "parameters": {
        "jsCode": "const msg = $('campos').first().json.msg;\n\nlet texto = \"\";\n\nif (msg.messageType === \"text\") {\n  texto = msg.msgtext ?? \"\";\n} else if (msg.messageType === \"media\") {\n  texto = msg.msgtextMedia ?? \"\";\n}\n\nconst pagamento = texto.match(/Forma de pagamento:\\s*\\*?(.*?)\\*?\\n/i);\nconst valorTotal = texto.match(/Valor Total:\\s*\\*?R\\$\\s*([\\d.,]+)\\*?/i);\n\nconst ehPix = pagamento?.[1]?.trim().toUpperCase() === \"PIX\";\nconst ehVendizap = texto.includes(\"Pedido feito com Vendizap\");\n\nreturn [\n  {\n    telefone: msg.telefone,\n    messageType: msg.messageType,\n    texto,\n    pagamento: pagamento?.[1]?.trim() ?? null,\n    valorTotal: valorTotal?.[1]?.trim() ?? null,\n    ehPix,\n    ehVendizap,\n    processarPedido: ehPix && ehVendizap\n  }\n];"
      },
