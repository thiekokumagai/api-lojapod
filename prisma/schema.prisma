generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                        String                     @id @default(uuid())
  subdomain                 String                     @unique
  title                     String
  adminEmail                String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  printToken                String?                    @unique @default(uuid())
  isActive                  Boolean                    @default(true)
  customDomain              String?                    @unique
  adminAuditLogs            AdminAuditLog[]
  billingPayments           BillingPayment[]
  cashRegisters             CashRegister[]
  cashTransactions          CashTransaction[]
  categories                Category[]
  combos                    Combo[]
  coupons                   Coupon[]
  courierTransactions       CourierTransaction[]
  couriers                  Courier[]
  customerAddresses         CustomerAddress[]
  customers                 Customer[]
  fixedCosts                FixedCost[]
  importJobs                ImportJob[]
  investmentTransactions    InvestmentTransaction[]
  loyaltyCards              LoyaltyCard[]
  loyaltyProgram            LoyaltyProgram?
  loyaltyRedemptions        LoyaltyRewardRedemption[]
  loyaltyTransactions       LoyaltyTransaction[]
  orderBumps                OrderBump[]
  orders                    Order[]
  products                  Product[]
  stockMovements            StockMovement[]
  stockNotificationRequests StockNotificationRequest[]
  storeDomain               StoreDomain?
  storeSessions             StoreSession[]
  storeSettings             StoreSettings?
  subscription              StoreSubscription?
  users                     User[]
  variations                Variation[]

  @@map("stores")
}

model StoreDomain {
  id               String   @id @default(uuid())
  storeId          String   @unique
  hostname         String   @unique
  cloudflareZoneId String   @unique
  nameserver1      String
  nameserver2      String
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_domains")
}

model User {
  id                  String          @id @default(uuid())
  name                String
  email               String          @unique
  password            String
  role                Role            @default(USER)
  permissions         String[]        @default([])
  refreshToken        String?
  expoPushToken       String?
  webPushSubscription Json?
  createdAt           DateTime        @default(now())
  storeId             String?
  adminAuditLogs      AdminAuditLog[]
  store               Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("users")
}

model BillingPlan {
  id                     String                  @id @default(uuid())
  name                   String
  description            String?
  price                  Decimal                 @db.Decimal(10, 2)
  trialDays              Int                     @default(7)
  isActive               Boolean                 @default(true)
  isPublic               Boolean                 @default(true)
  checkoutType           BillingPlanCheckoutType @default(RECURRING_SUBSCRIPTION)
  providerProductId      String?                 @unique
  nextSubscriptionPlanId String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  payments               BillingPayment[]
  nextSubscriptionPlan   BillingPlan?            @relation("PlanSequence", fields: [nextSubscriptionPlanId], references: [id])
  previousPlans          BillingPlan[]           @relation("PlanSequence")
  subscriptions          StoreSubscription[]

  @@map("billing_plans")
}

model StoreSubscription {
  id                     String               @id @default(uuid())
  storeId                String               @unique
  provider               String               @default("CAKTO")
  providerCustomerId     String?
  providerSubscriptionId String?              @unique
  providerOrderId        String?              @unique
  paymentMethod          BillingPaymentMethod @default(UNKNOWN)
  status                 BillingStatus        @default(TRIALING)
  monthlyFee             Decimal              @default(150.00) @db.Decimal(10, 2)
  supportSelected        Boolean              @default(false)
  supportPaidAt          DateTime?
  trialStartedAt         DateTime             @default(now())
  trialEndsAt            DateTime?
  currentPeriodEndsAt    DateTime?
  paymentDueAt           DateTime?
  overdueSince           DateTime?
  gracePeriodEndsAt      DateTime?
  suspendedAt            DateTime?
  canceledAt             DateTime?
  lastProviderSyncAt     DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  planId                 String?
  payments               BillingPayment[]
  plan                   BillingPlan?         @relation(fields: [planId], references: [id])
  store                  Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([status, gracePeriodEndsAt])
  @@map("store_subscriptions")
}

model BillingPayment {
  id                String               @id @default(uuid())
  storeId           String
  subscriptionId    String?
  providerPaymentId String?              @unique
  providerOrderId   String?
  kind              String               @default("MONTHLY_FEE")
  method            BillingPaymentMethod @default(UNKNOWN)
  status            BillingPaymentStatus @default(PENDING)
  amount            Decimal              @db.Decimal(10, 2)
  dueAt             DateTime?
  paidAt            DateTime?
  raw               Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  planId            String?
  plan              BillingPlan?         @relation(fields: [planId], references: [id])
  store             Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscription      StoreSubscription?   @relation(fields: [subscriptionId], references: [id])

  @@index([storeId, createdAt])
  @@map("billing_payments")
}

model CaktoWebhookEvent {
  id          String    @id @default(uuid())
  providerId  String    @unique
  event       String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@map("cakto_webhook_events")
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  storeId   String?
  action    String
  reason    String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
  store     Store?   @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
  @@map("admin_audit_logs")
}

model Category {
  id                    String      @id @default(uuid())
  externalId            String?     @unique
  title                 String
  image                 String?
  isVisible             Boolean     @default(true)
  excludeFromBestSeller Boolean     @default(false)
  order                 Int         @default(0)
  deletedAt             DateTime?
  storeId               String?
  store                 Store?      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  combos                Combo[]
  orderBumpTriggers     OrderBump[] @relation("OrderBumpTriggerCategory")
  products              Product[]

  @@map("categories")
}

model Variation {
  id        String             @id @default(uuid())
  title     String
  deletedAt DateTime?
  createdAt DateTime           @default(now())
  storeId   String?
  products  ProductVariation[]
  options   VariationOption[]
  store     Store?             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("variations")
}

model VariationOption {
  id          String              @id @default(uuid())
  value       String
  variationId String
  deletedAt   DateTime?
  createdAt   DateTime            @default(now())
  order       Int                 @default(0)
  itemOptions ProductItemOption[]
  variation   Variation           @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@unique([variationId, value, order])
  @@map("variation_options")
}

model Product {
  id                        String                     @id @default(uuid())
  externalId                String?                    @unique
  title                     String
  categoryId                String
  deletedAt                 DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @default(now()) @updatedAt
  isVisible                 Boolean                    @default(true)
  isBestSeller              Boolean                    @default(false)
  price                     Decimal?                   @db.Decimal(10, 2)
  promotionalPrice          Decimal?                   @db.Decimal(10, 2)
  costPrice                 Decimal?                   @db.Decimal(10, 2)
  description               String?
  descriptionFormated       String?
  storeId                   String?
  coverageDays              Int?
  dailyRunRate              Float?                     @default(0)
  daysWithoutSales          Int?                       @default(0)
  growthPercentage          Float?                     @default(0)
  lastStockAlertAt          DateTime?
  minStock                  Int                        @default(5)
  stockAlertState           String                     @default("OK")
  isFeatured                Boolean                    @default(false)
  totalSold                 Int                        @default(0)
  comboItems                ComboItem[]
  orderBumpSuggestions      OrderBump[]                @relation("OrderBumpSuggestedProduct")
  orderBumpTriggers         OrderBump[]                @relation("OrderBumpTriggerProduct")
  orderItems                OrderItem[]
  images                    ProductImage[]
  items                     ProductItem[]
  variations                ProductVariation[]
  category                  Category                   @relation(fields: [categoryId], references: [id])
  store                     Store?                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stockMovements            StockMovement[]
  stockNotificationRequests StockNotificationRequest[]

  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid())
  url        String
  productId  String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  externalId String?
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariation {
  id          String    @id @default(uuid())
  productId   String
  variationId String
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variation   Variation @relation(fields: [variationId], references: [id])

  @@unique([productId, variationId])
  @@map("product_variations")
}

model ProductItem {
  id                        String                     @id @default(uuid())
  productId                 String
  stock                     Int                        @default(0)
  hash                      String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  comboItems                ComboItem[]
  orderItems                OrderItem[]
  options                   ProductItemOption[]
  product                   Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements            StockMovement[]
  stockNotificationRequests StockNotificationRequest[]

  @@unique([productId, hash])
  @@index([productId])
  @@map("product_items")
}

model ProductItemOption {
  id       String          @id @default(uuid())
  itemId   String
  optionId String
  item     ProductItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  option   VariationOption @relation(fields: [optionId], references: [id])

  @@unique([itemId, optionId])
  @@map("product_item_options")
}

model StoreSettings {
  id                            String   @id @default(uuid())
  storeName                     String   @default("Minha Loja")
  logoUrl                       String?
  whiteLogoUrl                  String?
  faviconUrl                    String?
  topHeaderText                 String?
  bannerUrls                    String[]
  phone                         String   @default("")
  instagram                     String?
  pixelId                       String?
  marketingLinks                Json?
  cep                           String   @default("")
  street                        String   @default("")
  number                        String   @default("")
  neighborhood                  String   @default("")
  city                          String   @default("")
  state                         String   @default("")
  complement                    String?
  hideAddress                   Boolean  @default(false)
  pixEnabled                    Boolean  @default(false)
  pixKeyType                    String?
  pixKey                        String?
  pixHolder                     String?
  payOnDeliveryCash             Boolean  @default(false)
  payOnDeliveryCardDebit        Boolean  @default(false)
  payOnDeliveryCardCredit       Boolean  @default(false)
  paymentRules                  Json?
  promoPaymentMethods           String[] @default(["pix"])
  deliveryOriginCep            String?
  deliveryOriginNumber          String?
  deliveryRanges                Json?
  installmentRules              Json?
  businessHours                 Json?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  storeId                       String?  @unique
  closedNoticeMessage           String?
  isTemporarilyClosed           Boolean  @default(false)
  enableExchangePolicy          Boolean  @default(false)
  exchangePolicy                String?
  deliveryFixedFee              Decimal? @db.Decimal(10, 2)
  deliveryType                  String   @default("DISTANCE")
  freeShippingEnabled           Boolean  @default(false)
  freeShippingMinValue          Decimal? @db.Decimal(10, 2)
  storePickupEnabled            Boolean  @default(false)
  vendizapAuthId                String?
  vendizapAuthSecret            String?
  facebookConversionsToken      String?
  facebookConversionsApiEnabled Boolean  @default(false)
  facebookPixelEnabled          Boolean  @default(false)
  templateId                    String   @default("classic")
  primaryColor                  String?  @default("#dc2626")
  secondaryColor                String?  @default("#18181b")
  priceColor                    String?  @default("#16a34a")
  defaultProductSort            String?  @default("newest")
  autoHideOutOfStock            Boolean  @default(true)
  enableStockAlertNotification  Boolean  @default(true)
  paymentGateways               Json?
  showVariationsOnCard          Boolean  @default(true)
  searchFilters                 Json?
  savedStoreAddresses           Json?
  payOnDeliveryFoodVoucher      Boolean  @default(false)
  payOnDeliveryMealVoucher      Boolean  @default(false)
  uberDirectAutoDispatch        Boolean  @default(false)
  uberDirectClientId            String?
  uberDirectClientSecret        String?
  uberDirectCustomerId          String?
  uberDirectEnabled             Boolean  @default(false)
  uberDirectEnvironment         String   @default("sandbox")
  uberDirectPickupInstructions  String?
  uberDirectPickupPhone         String?
  uberDirectBatchSize           Int      @default(3)
  uberDirectMaxAngleDelta       Float    @default(45.0)
  uberDirectDispatchDelayMinutes Int      @default(0)
  store                         Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model Coupon {
  id                      String       @id @default(uuid())
  title                   String
  status                  Boolean      @default(true)
  type                    DiscountType
  value                   Decimal?     @db.Decimal(10, 2)
  validUntilDate          DateTime?
  startTime               DateTime?
  endTime                 DateTime?
  maxUses                 Int?
  currentUses             Int          @default(0)
  minOrderValue           Decimal?     @db.Decimal(10, 2)
  applyToPromotionalItems Boolean      @default(false)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  storeId                 String?
  store                   Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders                  Order[]

  @@unique([storeId, title])
  @@map("coupons")
}

model Customer {
  id           String            @id @default(uuid())
  name         String
  phone        String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  storeId      String?
  isBlocked    Boolean           @default(false)
  addresses    CustomerAddress[]
  store        Store?            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  loyaltyCards LoyaltyCard[]
  orders       Order[]

  @@unique([storeId, phone])
  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String
  street       String
  number       String
  neighborhood String
  city         String
  state        String
  cep          String
  complement   String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  storeId      String?
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Order {
  id                    String                   @id @default(uuid())
  externalId            String?                  @unique
  orderNumber           Int                      @default(autoincrement())
  customerId            String?
  customerName          String
  customerPhone         String
  itemsTotal            Decimal                  @db.Decimal(10, 2)
  freight               Decimal                  @db.Decimal(10, 2)
  totalOrder            Decimal                  @db.Decimal(10, 2)
  totalReceived         Decimal                  @db.Decimal(10, 2)
  cardFee               Decimal                  @default(0) @db.Decimal(10, 2)
  paymentDiscount       Decimal                  @default(0) @db.Decimal(10, 2)
  installmentSurcharge  Decimal                  @default(0) @db.Decimal(10, 2)
  couponDiscount        Decimal                  @default(0) @db.Decimal(10, 2)
  couponFreightDiscount Decimal                  @default(0) @db.Decimal(10, 2)
  receiptDiscount       Decimal                  @default(0) @db.Decimal(10, 2)
  receiptSurcharge      Decimal                  @default(0) @db.Decimal(10, 2)
  amountProvided        Decimal?                 @db.Decimal(10, 2)
  changeAmount          Decimal?                 @db.Decimal(10, 2)
  appliedTaxRule        Json?
  appliedCouponRule     Json?
  paymentType           String
  paymentMethod         String
  pixKey                String?
  street                String
  number                String
  neighborhood          String
  city                  String
  state                 String
  cep                   String
  complement            String?
  observation           String?
  status                OrderStatus              @default(PENDING)
  paymentStatus         PaymentStatus            @default(PENDING)
  installments          Int?                     @default(1)
  paymentDate           DateTime?
  isPrinted             Boolean                  @default(false)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  couponId              String?
  courierTransactionId  String?
  storeId               String?
  deliveryModality      String                   @default("DELIVERY")
  gatewayCheckoutUrl    String?
  gatewayTransactionId  String?
  onlineGateway         String?
  uberDeliveryFee       Decimal?                 @db.Decimal(10, 2)
  uberDeliveryId        String?
  uberDeliveryStatus    String?
  uberTrackingUrl       String?                  @db.Text
  uberBatchId           String?
  loyaltyRedemption     LoyaltyRewardRedemption?
  items                 OrderItem[]
  coupon                Coupon?                  @relation(fields: [couponId], references: [id])
  courierTransaction    CourierTransaction?      @relation(fields: [courierTransactionId], references: [id])
  customer              Customer?                @relation(fields: [customerId], references: [id])
  store                 Store?                   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model OrderItem {
  id            String       @id @default(uuid())
  orderId       String
  productId     String?
  productItemId String?
  productName   String
  price         Decimal      @db.Decimal(10, 2)
  quantity      Int
  variation     String?
  comboId       String?
  comboSnapshot Json?
  isCombo       Boolean      @default(false)
  isOrderBump   Boolean      @default(false)
  orderBumpId   String?
  combo         Combo?       @relation(fields: [comboId], references: [id])
  orderBump     OrderBump?   @relation(fields: [orderBumpId], references: [id])
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?     @relation(fields: [productId], references: [id])
  productItem   ProductItem? @relation(fields: [productItemId], references: [id])

  @@map("order_items")
}

model CashRegister {
  id           String            @id @default(uuid())
  title        String
  startDate    DateTime          @db.Date
  endDate      DateTime          @db.Date
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  storeId      String?
  store        Store?            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactions CashTransaction[]

  @@map("cash_registers")
}

model FixedCost {
  id                String            @id @default(uuid())
  name              String
  value             Decimal           @db.Decimal(10, 2)
  repeats           Boolean           @default(true)
  type              String            @default("ALWAYS")
  installmentsCount Int?              @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  storeId           String?
  transactions      CashTransaction[]
  store             Store?            @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("fixed_costs")
}

model CashTransaction {
  id             String        @id @default(uuid())
  cashRegisterId String?
  type           String
  category       String?       @default("GENERAL")
  amount         Decimal       @db.Decimal(10, 2)
  description    String
  date           DateTime      @default(now())
  fixedCostId    String?
  createdAt      DateTime      @default(now())
  storeId        String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])
  fixedCost      FixedCost?    @relation(fields: [fixedCostId], references: [id])
  store          Store?        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("cash_transactions")
}

model InvestmentTransaction {
  id          String   @id @default(uuid())
  type        String
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("investment_transactions")
}

model StockMovement {
  id            String            @id @default(uuid())
  type          StockMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  observation   String?
  createdAt     DateTime          @default(now())
  productId     String
  productItemId String?
  storeId       String?
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productItem   ProductItem?      @relation(fields: [productItemId], references: [id], onDelete: Cascade)
  store         Store?            @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productItemId])
  @@map("stock_movements")
}

model Courier {
  id           String               @id @default(uuid())
  name         String
  phone        String
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  storeId      String?
  transactions CourierTransaction[]
  store        Store?               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("couriers")
}

model CourierTransaction {
  id          String                 @id @default(uuid())
  courierId   String
  type        CourierTransactionType
  amount      Decimal                @db.Decimal(10, 2)
  description String
  date        DateTime               @default(now())
  createdAt   DateTime               @default(now())
  storeId     String?
  courier     Courier                @relation(fields: [courierId], references: [id], onDelete: Cascade)
  store       Store?                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@map("courier_transactions")
}

model StoreSession {
  id              String     @id @default(uuid())
  sessionId       String     @unique
  startedAt       DateTime   @default(now())
  lastHeartbeatAt DateTime   @default(now())
  durationSeconds Int        @default(0)
  isConverted     Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  storeId         String?
  cartDraft       CartDraft?
  store           Store?     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_sessions")
}

model CartDraft {
  id          String       @id @default(uuid())
  sessionId   String       @unique
  cartItems   Json
  totalAmount Decimal      @db.Decimal(10, 2)
  isAbandoned Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  session     StoreSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@map("cart_drafts")
}

model ImportJob {
  id           String   @id @default(uuid())
  storeId      String?
  type         String
  status       String
  lastSkip     Int      @default(0)
  totalFetched Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("import_jobs")
}

model StockNotificationRequest {
  id            String       @id @default(uuid())
  storeId       String?
  productId     String?
  productItemId String?
  customerName  String
  customerPhone String
  status        String       @default("PENDING")
  notifiedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  comboId       String?
  combo         Combo?       @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product       Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productItem   ProductItem? @relation(fields: [productItemId], references: [id])
  store         Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, productId, status])
  @@index([storeId, comboId, status])
  @@map("stock_notification_requests")
}

model LoyaltyProgram {
  id                    String   @id @default(uuid())
  storeId               String   @unique
  isActive              Boolean  @default(false)
  stampsRequired        Int      @default(10)
  minOrderValue         Decimal  @default(0.00) @db.Decimal(10, 2)
  validityDays          Int      @default(30)
  rewardText            String   @default("Ganhe 1 Produto ou Desconto Especial")
  rewardCouponCode      String?
  rewardDiscount        Decimal? @db.Decimal(10, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  cashbackPercent       Decimal  @default(5.00) @db.Decimal(10, 2)
  pointsPerReal         Decimal  @default(1.00) @db.Decimal(10, 2)
  pointsRedemptionValue Decimal  @default(0.05) @db.Decimal(10, 2)
  progressiveTiers      Json?
  type                  String   @default("FREE_PRODUCT")
  minPointsToRedeem     Int      @default(0)
  store                 Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("loyalty_programs")
}

model LoyaltyCard {
  id              String                    @id @default(uuid())
  storeId         String
  customerId      String?
  customerPhone   String
  customerName    String?
  currentStamps   Int                       @default(0)
  totalCompleted  Int                       @default(0)
  startedAt       DateTime?
  expiresAt       DateTime?
  status          String                    @default("ACTIVE")
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  cashbackBalance Decimal                   @default(0.00) @db.Decimal(10, 2)
  pointsBalance   Decimal                   @default(0.00) @db.Decimal(10, 2)
  customer        Customer?                 @relation(fields: [customerId], references: [id])
  store           Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  redemptions     LoyaltyRewardRedemption[]
  transactions    LoyaltyTransaction[]

  @@unique([storeId, customerPhone])
  @@index([storeId, customerPhone, status])
  @@map("loyalty_cards")
}

model LoyaltyTransaction {
  id             String      @id @default(uuid())
  storeId        String
  loyaltyCardId  String
  orderId        String?
  type           String
  stampsCount    Int         @default(0)
  description    String?
  createdAt      DateTime    @default(now())
  cashbackAmount Decimal?    @db.Decimal(10, 2)
  pointsAmount   Decimal?    @db.Decimal(10, 2)
  loyaltyCard    LoyaltyCard @relation(fields: [loyaltyCardId], references: [id], onDelete: Cascade)
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, loyaltyCardId])
  @@map("loyalty_transactions")
}

model LoyaltyRewardRedemption {
  id            String      @id @default(uuid())
  storeId       String
  loyaltyCardId String
  orderId       String?     @unique
  customerPhone String
  customerName  String?
  rewardType    String
  rewardTitle   String
  status        String      @default("PENDING_DELIVERY")
  deliveredAt   DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  loyaltyCard   LoyaltyCard @relation(fields: [loyaltyCardId], references: [id], onDelete: Cascade)
  order         Order?      @relation(fields: [orderId], references: [id])
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@map("loyalty_reward_redemptions")
}

model Combo {
  id                        String                     @id @default(uuid())
  storeId                   String
  name                      String
  description               String?
  imageUrl                  String?
  images                    String[]                   @default([])
  categoryId                String?
  price                     Decimal                    @db.Decimal(10, 2)
  isActive                  Boolean                    @default(true)
  startDate                 DateTime?
  endDate                   DateTime?
  maxPerOrder               Int?
  maxTotalSales             Int?
  totalSold                 Int                        @default(0)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  isFeatured                Boolean                    @default(false)
  isBestSeller              Boolean                    @default(false)
  items                     ComboItem[]
  category                  Category?                  @relation(fields: [categoryId], references: [id])
  store                     Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems                OrderItem[]
  stockNotificationRequests StockNotificationRequest[]

  @@index([storeId, isActive])
  @@map("combos")
}

model ComboItem {
  id            String       @id @default(uuid())
  comboId       String
  productId     String
  productItemId String?
  quantity      Int          @default(1)
  variation     String?
  combo         Combo        @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productItem   ProductItem? @relation(fields: [productItemId], references: [id])

  @@map("combo_items")
}

model OrderBump {
  id                 String      @id @default(uuid())
  storeId            String
  title              String      @default("Peça também")
  isActive           Boolean     @default(true)
  priority           Int         @default(0)
  triggerType        String      @default("ALL")
  triggerProductId   String?
  triggerCategoryId  String?
  suggestedProductId String
  customPrice        Decimal?    @db.Decimal(10, 2)
  discountPercent    Decimal?    @db.Decimal(5, 2)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  conversionsCount   Int         @default(0)
  totalRevenue       Decimal     @default(0) @db.Decimal(10, 2)
  viewsCount         Int         @default(0)
  store              Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  suggestedProduct   Product     @relation("OrderBumpSuggestedProduct", fields: [suggestedProductId], references: [id], onDelete: Cascade)
  triggerCategory    Category?   @relation("OrderBumpTriggerCategory", fields: [triggerCategoryId], references: [id], onDelete: Cascade)
  triggerProduct     Product?    @relation("OrderBumpTriggerProduct", fields: [triggerProductId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]

  @@index([storeId, isActive])
  @@map("order_bumps")
}

