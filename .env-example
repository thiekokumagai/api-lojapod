# Frete recalculado no servidor (pedido da loja pública). Chave da Routes API do Google, só no servidor.
# Sem ela, o servidor só confere o frete pelas faixas da loja (veja FREIGHT_ON_GOOGLE_FAILURE).
GOOGLE_MAPS_SERVER_KEY=
# Se o Google falhar ou a chave faltar: "bounds" (padrão: aceita só frete dentro das faixas da loja) ou "reject" (recusa o pedido)
FREIGHT_ON_GOOGLE_FAILURE=bounds
# Quantos proxies confiáveis existem na frente da API (para o limite de tentativas por IP)
RATE_LIMIT_PROXY_HOPS=1
